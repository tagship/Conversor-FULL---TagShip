{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Estudio",
  "version": "1.0.0",
  "identifier": "ar.tagship.estudio",
  "build": { "frontendDist": "../dist" },
  "app": {
    "windows": [
      {
        "title": "Estudio",
        "url": "https://tagshipstudio.web.app/",
        "width": 1440,
        "height": 900,
        "minWidth": 820,
        "minHeight": 560,
        "center": true,
        "maximized": true,
        "dragDropEnabled": false
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "publisher": "TagShip",
    "shortDescription": "Editor de diseños",
    "windows": {
      "nsis": { "installMode": "currentUser", "languages": ["Spanish"] },
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    }
  }
}
